<?xml version="1.0" encoding="UTF-8"?>
<scanner name="SharpCap" version="1">

  <folderPattern regex="\d{4}-\d{2}-\d{2}_\d{2}_\d{2}_\d{2}"/>

  <timestamp source="folderName"
             pattern="\d{4}-\d{2}-\d{2}_\d{2}_\d{2}_\d{2}"
             format="yyyy-MM-dd_HH_mm_ss"/>

  <fileParser filePattern="CameraSettings\.txt" format="keyvalue" separator="=">
    <field src="Gain"        key="gain"/>
    <field src="Exposure"    key="exposure_ms"/>
    <field src="Binning"     key="binning"/>
    <field src="FPS"         key="fps"/>
    <field src="FrameCount"  key="frame_count"/>
  </fileParser>

  <fileParser filePattern=".*\.ser" format="filename" separator="">
    <field src="filename" key="ser_file"/>
  </fileParser>

</scanner>
